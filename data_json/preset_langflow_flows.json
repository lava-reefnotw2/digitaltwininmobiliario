        "targetNodeId": "node-llm-agent",
        "targetHandle": "in-normativa"
      },
      {
        "id": "c5",
        "sourceNodeId": "node-llm-agent",
        "sourceHandle": "out-decision",
        "targetNodeId": "node-output-3d",
        "targetHandle": "in-decision"
      }
    ]
  },
  {
