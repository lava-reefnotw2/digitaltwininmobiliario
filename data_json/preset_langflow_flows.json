      {
        "id": "node-llm-optimizer",
        "name": "Agente Optimizador Multiobjetivo",
        "type": "model",
        "category": "Models",
        "description": "Equilibra cobertura poblacional máxima vs costo de obra de contención.",
        "inputs": [
